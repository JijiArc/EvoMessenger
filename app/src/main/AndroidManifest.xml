<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.mathroda.messengerclone">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested at runtime, only when the user taps Record in the voice sheet. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The microphone is the only hardware the voice changer needs. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Lets the app see whether Messenger is installed (needed on Android 11+ when targetSdk >= 30). -->
    <queries>
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.mlite" />
    </queries>

    <application
        android:name=".MessengerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MessengerClone"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- Shares voice recordings from cacheDir/voice only. Own subclass avoids a manifest clash with libraries. -->
        <provider
            android:name=".voice.VoiceFileProvider"
            android:authorities="${applicationId}.voicefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/voice_file_paths" />
        </provider>

        <activity
            android:name=".scanner.ScannerActivity"
            android:exported="false"
            android:label="@string/title_activity_scanner"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:label="@string/title_activity_search"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:label="@string/title_activity_profile"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <activity
            android:name=".ui.channels.ChannelsActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.login.UserLoginActivity"
            android:exported="false"
            android:label="@string/title_activity_user_login"
            android:theme="@style/Theme.MessengerClone"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.messages.MessagesActivity"
            android:exported="false"
            android:label="@string/title_activity_messages"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MessengerClone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
